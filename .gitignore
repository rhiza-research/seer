.config/

.DS_Store
__pycache__/

# data/ is bulk gams data (raw/extracted/seer-schema outputs), regenerable and often large --
# ignored by default, with specific carve-outs for files/folders worth tracking in git.
data/*
!data/readme.md
!data/processed_gams
.claude

# vendored source CSVs for seer/scenarios/reference_data, re-downloaded by scripts/build_cost_ranges.py
seer/scenarios/reference_data/.cache/

# scratch/exploration/smoke-test scripts have accumulated here -- ignored for now rather than
# tracked piecemeal; worth revisiting once it's clearer which ones are worth keeping long-term
scripts/

# local experiments and job scripts -- kept on disk but not tracked
experiments/
jobs/
